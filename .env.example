DATABASE_URL=postgres://postgres:postgres@localhost:5432/surat_digital
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate independent, random values for every deployed environment.
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_TOTP_SECRET=replace-with-a-base32-totp-secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Local development only. Payment simulation is always disabled in production.
PAYMENT_SIMULATION_ENABLED=true
